# Copy this file to .env.ring-backed-sepolia and replace every 0x... value.
# The copied file is ignored by git. Values are raw token units unless noted.

# RPC and broadcaster. The broadcaster must have Sepolia ETH for gas.
FOUNDRY_PROFILE=sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_ME
SEPOLIA_PRIVATE_KEY=0xREPLACE_ME

# OWNER is optional and defaults to the broadcaster. If set to another address,
# that address must run initialize/admin transactions.
# OWNER=0x0000000000000000000000000000000000000000

# Uniswap v4 Sepolia PoolManager.
POOL_MANAGER_ADDR=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
V4_POSITION_MANAGER_ADDR=0x429ba70129df741B2Ca2a85BC3A2a3328e5c09b4
PERMIT2_ADDR=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Ring Sepolia deployments sourced from /Users/qiuchenghui/Github/Few/new-interface.
FEW_FACTORY_ADDR=0x226e65279E177A779522864Ce1dE40c85E2C08A5
FEW_V2_FACTORY_ADDR=0x3D7101fDe92D0961cAc4b39Ee5A638d7B6A88090
WETH_ADDR=0xfff9976782d46cc05630d1f6ebab18b2324d6b14
FW_WETH_ADDR=0x98b902eF4f9fEB2F6982ceEB4E98761294854D61

# SeedRingTestPool deploys one test token and creates its direct fwToken/fwWETH
# FewV2 pair with these amounts. Both tokens use 18 decimals.
RING_WETH_AMOUNT=1000000000000000000
RING_TEST_TOKEN_AMOUNT=1000000000000000000000000
TEST_TOKEN_SUPPLY=1000000000000000000000000000

# Managed full-range base position in the v4 Ring-backed pool.
V4_BASE_WETH_AMOUNT=10000000000000000
V4_BASE_TEST_TOKEN_AMOUNT=10000000000000000000000

# Optional CREATE2 search start. Usually leave this at zero.
SALT_START=0

# deploy-all runs the complete local test suite before broadcasting by default.
# Set RUN_CHECKS=false on the command line only when the same build was already checked.
RUN_CHECKS=true

# Fill these after DeployRingBacked prints them.
RING_BACKED_FACTORY_ADDR=0x0000000000000000000000000000000000000000
RING_BACKED_HOOK_ADDR=0x0000000000000000000000000000000000000000
RING_LP_ROUTER_ADDR=0x0000000000000000000000000000000000000000

# Fill these from seed-ring output. TEST_TOKEN_ADDR is also used to map the
# desired RHT amount when minting the permanent v4 NFT.
TEST_TOKEN_ADDR=0x30EB24aE5Ff3bd13c91859A99Ca7d95Eb5be0611

# Raw underlying ERC20 addresses. After seed-ring, set one side to WETH_ADDR and
# the other to the printed TEST_TOKEN_ADDR. Scripts sort these into currency0/currency1.
TOKEN_A_ADDR=0x30EB24aE5Ff3bd13c91859A99Ca7d95Eb5be0611
TOKEN_B_ADDR=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
TICK_SPACING=60
# sqrt(1 WETH / 1,000,000 RHT) * 2^96; valid because both tokens use 18 decimals.
INITIAL_SQRT_PRICE_X96=79228162514264337593543950

# Canonical fwToken route, ordered from the wrapper of sorted currency0 to the
# wrapper of sorted currency1. Use printed FW_TEST_TOKEN_ADDR and FW_WETH_ADDR.
FW_PATH=0x6027Ed0e3cD2f8DADD86B1134D4C29662CFF8FEf,0x98b902eF4f9fEB2F6982ceEB4E98761294854D61

# Owner-funded rounding reserve for sorted currency0 and currency1.
ROUNDING_AMOUNT0=1000000
ROUNDING_AMOUNT1=1000000

# Swap settings. Negative AMOUNT_SPECIFIED is exact-input; positive is exact-output.
# To request exactly 10,000 RHT with at most 0.1 WETH, use the two numeric
# values below and set ZERO_FOR_ONE to the value printed by seed-ring.
ZERO_FOR_ONE=false
AMOUNT_SPECIFIED=10000000000000000000000
AMOUNT_LIMIT=100000000000000000
DEADLINE_FROM_NOW=600

# Set SYNC_ONLY=true to trade only against the permanent v4 LP and move its spot price toward Ring.
# Supply an exact SQRT_PRICE_LIMIT_X96 target and conservative AMOUNT_LIMIT when synchronizing.
SYNC_ONLY=false
# SQRT_PRICE_LIMIT_X96=

# AdminRingBacked settings; set these only when running an admin action.
ACTION=setPoolLive
LIVE=false
TOKEN_ADDR=0x0000000000000000000000000000000000000000
AMOUNT=0
TO=0x0000000000000000000000000000000000000000
