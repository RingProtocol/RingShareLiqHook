        <mxCell id="h5_name" value="RingV4BackedLiqHook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h5_user" value="User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="830" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h5_v4" value="V4 Pool&#xa;(full-range base LP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="830" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h5_hook" value="Hook&#xa;(不存 FewToken&#xa;不用 Ring V2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="820" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h5_fv4" value="FewToken V4 Pool&#xa;(报价 + 真实 swap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="830" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h5_jit_add" value="JIT 添加流动性&#xa;(modifyLiquidity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="830" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h5_swap" value="User 交易&#xa;JIT 流动性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1170" y="830" width="120" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h5_jit_rm" value="JIT 移除&#xa;(afterSwap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1340" y="830" width="110" height="50" as="geometry"/>
        </mxCell>
        <!-- Arrows -->
        <mxCell id="h5_e1" value="① swap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="h5_user" target="h5_v4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h5_e2" value="② beforeSwap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;" edge="1" parent="1" source="h5_v4" target="h5_hook">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h5_e3" value="③ 报价+swap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#d79b00;" edge="1" parent="1" source="h5_hook" target="h5_fv4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h5_e4" value="④ 真实流动性" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#d79b00;" edge="1" parent="1" source="h5_fv4" target="h5_jit_add">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h5_e5" value="⑤ JIT 入池" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#d6b656;" edge="1" parent="1" source="h5_jit_add" target="h5_v4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="910"/>
              <mxPoint x="470" y="910"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="h5_e6" value="⑥ 交易JIT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#6c8ebf;" edge="1" parent="1" source="h5_v4" target="h5_swap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="920"/>
              <mxPoint x="1230" y="920"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="h5_e7" value="⑦ afterSwap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#d6b656;" edge="1" parent="1" source="h5_swap" target="h5_jit_rm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h5_e8" value="⑧ 返回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="h5_swap" target="h5_user">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1230" y="935"/>
              <mxPoint x="305" y="935"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="h5_notes" value="特点：&#xa;• Hook 不存 FewToken，不用 Ring V2&#xa;• FewToken V4 池提供真实流动性（wrap → v4 swap → unwrap）&#xa;• JIT 流动性插入 V4 池供用户交易&#xa;• afterSwap 移除 JIT，结算 rounding&#xa;• 后端：FewToken V4 Pool（setFbPool 配置）" style="text;html=1;align=left;spacingLeft=6;fontSize=10;fillColor=#fffbe6;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1480" y="815" width="180" height="100" as="geometry"/>
        </mxCell>

        <!-- ============ Comparison Summary ============ -->
        <mxCell id="summary_bg" value="" style="rounded=1;whiteSpace=wrap;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1620" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="summary_title" value="对比总结" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="1015" width="200" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="summary1" value="聚合器模式 (RingV2Aggregator / FewV4Shell)：Hook 在 beforeSwap 中直接调用后端完成 swap，通过修改 delta 返回结果。V4 池本身不执行交易，仅作为入口。" style="text;html=1;fontSize=11;align=left;spacingLeft=6;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="55" y="1045" width="1550" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="summary2" value="JIT 模式 (ShareLiq 2.0 / V2Backed / V4Backed)：Hook 在 beforeSwap 中从后端获取真实流动性，以 JIT 方式插入 V4 池，用户在 V4 池中与 JIT 流动性交易，afterSwap 移除 JIT。" style="text;html=1;fontSize=11;align=left;spacingLeft=6;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="55" y="1072" width="1550" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="summary3" value="ShareLiq 2.0 = Hook 自存 FewToken + V2 公式算价（无外部后端执行）  |  V2Backed = Ring V2 池做后端  |  V4Backed = FewToken V4 池做后端（setFbPool 可配置）" style="text;html=1;fontSize=11;align=left;spacingLeft=6;fontColor=#555555;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="55" y="1099" width="1550" height="25" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
